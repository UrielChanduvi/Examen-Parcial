@model PortalAcademico.ViewModels.CursoFormViewModel
@{
    ViewData["Title"] = $"Editar curso {Model.Nombre}";
}

<h1 class="mb-4">Editar curso</h1>

<form asp-action="Editar" method="post" class="border rounded p-3">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <partial name="_CursoFormFields" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Cursos" class="btn btn-outline-secondary">Volver</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
