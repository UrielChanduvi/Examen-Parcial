@model PortalAcademico.Models.Curso

@{
    ViewData["Title"] = $"Curso {Model.Nombre}";
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="alert">@successMessage</div>
}
else if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<section class="course-detail-card">
    <div class="course-detail-header">
        <div>
            <div class="course-meta">@Model.Codigo • @Model.Creditos crédito(s)</div>
            <h1 class="course-detail-title">@Model.Nombre</h1>
        </div>
    </div>

    <div class="course-detail-meta">
        <div class="detail-item">
            <span>Horario</span>
            <strong>@Model.HorarioInicio:hh\:mm - @Model.HorarioFin:hh\:mm</strong>
        </div>
        <div class="detail-item">
            <span>Cupo máximo</span>
            <strong>@Model.CupoMaximo estudiantes</strong>
        </div>
        <div class="detail-item">
            <span>Estado</span>
            <strong>@(Model.Activo ? "Disponible" : "No disponible")</strong>
        </div>
    </div>

    <div class="detail-actions">
        @if (User.Identity?.IsAuthenticated ?? false)
        {
            <form asp-controller="Matriculas" asp-action="Create" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="cursoId" value="@Model.Id" />
                <button type="submit" class="btn btn-fia">Inscribirme en este curso</button>
            </form>
        }
        else
        {
            <a asp-area="Identity" asp-page="/Account/Login" asp-route-returnUrl="@Url.Action("Details", "Cursos", new { id = Model.Id })" class="btn btn-fia">Iniciar sesión para inscribirme</a>
        }
        <a asp-action="Index" class="btn btn-outline-fia">Volver al catálogo</a>
    </div>
</section>
